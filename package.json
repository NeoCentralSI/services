{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:generate:no-engine": "prisma generate --no-engine",
    "test:unit": "vitest run --config vitest.unit.config.js",
    "test:unit:nabil": "vitest run src/test/unit/nabil --config vitest.unit.config.js",
    "test:unit:fathur": "vitest run src/test/unit/fathur --config vitest.unit.config.js",
    "test:unit:coverage": "vitest run --coverage --config vitest.unit.config.js",
    "test:unit:fathur:coverage": "vitest run --coverage --config vitest.unit.fathur.config.js",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:integration:nabil": "vitest run src/test/integration/nabil --config vitest.integration.config.js",
    "test:integration:fathur": "vitest run src/test/integration/fathur --config vitest.integration.config.js",
    "test:integration:scenarios:fathur": "vitest run src/test/integration/use-scenarios --config vitest.integration.config.js",
    "test:integration:fariz": "vitest run src/test/integration/fariz --config vitest.integration.config.js",
    "test:system:fathur": "vitest run src/test/system/fathur --config vitest.system.config.js",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "ensure-users": "node scripts/ensure-users.js",
    "sync:dsi-master": "node scripts/sync-dsi-master.js",
    "merge:legacy-kbk": "node scripts/sync-dsi-master.js --legacy-groups-only",
    "verify:dsi-master": "node scripts/verify-dsi-master.js",
    "integrity:audit-supervisors": "node scripts/audit-supervisor-integrity.js",
    "integrity:repair-supervisors": "node scripts/repair-supervisor-integrity.js",
    "academic-years:audit": "node scripts/repair-academic-year-integrity.mjs",
    "academic-years:repair": "node scripts/repair-academic-year-integrity.mjs --apply",
    "snapshots:audit": "node scripts/backfill-student-period-snapshots.mjs",
    "snapshots:backfill": "node scripts/backfill-student-period-snapshots.mjs --apply",
    "seed:metopen-eligible": "node scripts/seed-metopen-eligible-students.js",
    "lint:prisma-delegates": "node scripts/lint-prisma-delegates.mjs",
    "worker": "node scripts/run-workers.js"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "1.6.1",
