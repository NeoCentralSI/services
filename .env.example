# Required
NODE_ENV=production
BASE_URL=https://api.your-domain.com
FRONTEND_URL=https://your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Use passwords without @ : / ? # (e.g. openssl rand -hex 24)
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=neocentral
MYSQL_USER=neocentral
MYSQL_PASSWORD=change-me

JWT_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me

# Microsoft Entra ID; REDIRECT_URI must match the app registration exactly
CLIENT_ID=
CLIENT_SECRET=
TENANT_ID=
REDIRECT_URI=https://api.your-domain.com/auth/microsoft/callback

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Firebase Cloud Messaging
# Pilih salah satu opsi
# Opsi A: JSON service account (satu variabel)
FCM_SERVICE_ACCOUNT_JSON=

# Opsi B: Tiga variabel terpisah (lebih mudah ditulis di .env)
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=

# Empty SIA_BASE_URL skips synchronization; dummy-SIA on the same host: http://host.docker.internal:4000
SIA_BASE_URL=
SIA_API_TOKEN=

# Docker Compose
BACKEND_IMAGE=neocentral-backend
BACKEND_BIND=127.0.0.1
BACKEND_PORT=3000
MYSQL_PORT=3306

# phpMyAdmin
PMA_BIND=127.0.0.1
PMA_PORT=8085

# Diisi ketika menjalankan aplikasi tanpa Docker (Compose sudah menyetel ini)
DATABASE_URL=mysql://neocentral:change-me@localhost:3306/neocentral
REDIS_URL=redis://localhost:6379
GOTENBERG_URL=http://localhost:3001

# Opsional (Default sudah diset pada masing-masing config)
PORT=3000
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d
ENABLE_CRON=true
ENABLE_SIA_CRON=false
ENABLE_DEVTOOLS=false
SIA_MOCK=false
SIA_FETCH_TIMEOUT=10000
SIA_CHUNK_SIZE=200
LOG_LEVEL=debug
LOG_TO_FILE=false
APP_NAME=NeoCentral API
APP_OWNER=Universitas Andalas

SEMINAR_MIN_BIMBINGAN=8
SEMINAR_MIN_KEHADIRAN=8
REQUIREMENT_DOCUMENT_MAX_SIZE_MB=10
METOPEL_PASSING_SCORE=60

CRON_TIME_NOTIFY=0 * * * *
GUIDANCE_REMINDER_CRON=0 7 * * *
GUIDANCE_REMINDER_TZ=Asia/Jakarta
DAILY_THESIS_REMINDER_CRON=0 9 * * *
DAILY_THESIS_REMINDER_TZ=Asia/Jakarta
ACADEMIC_YEAR_SYNC_CRON=0 1 * * *
ACADEMIC_YEAR_SYNC_TZ=Asia/Jakarta
ACADEMIC_EVENT_DAY_CRON=0 7 * * *
ACADEMIC_EVENT_H_MINUS_ONE_CRON=0 18 * * *
ACADEMIC_EVENT_REMINDER_TZ=Asia/Jakarta
QUOTA_SYNC_CRON=15 1 * * *
QUOTA_SYNC_TZ=Asia/Jakarta
SUPERVISOR_REQUEST_REMINDER_CRON=30 7 * * *
SUPERVISOR_REQUEST_REMINDER_TZ=Asia/Jakarta
SUPERVISOR_ASSIGNMENT_REMINDER_CRON=0 8 * * *
SUPERVISOR_ASSIGNMENT_REMINDER_TZ=Asia/Jakarta
EXAMINER_NO_RESPONSE_REMINDER_CRON=0 8 * * *
EXAMINER_NO_RESPONSE_REMINDER_TZ=Asia/Jakarta
YUDISIUM_REGISTRATION_OPEN_REMINDER_CRON=0 6 * * *
YUDISIUM_REGISTRATION_CLOSING_REMINDER_CRON=0 12 * * *
YUDISIUM_REGISTRATION_CLOSED_REMINDER_CRON=0 6 * * *
YUDISIUM_REGISTRATION_REMINDER_TZ=Asia/Jakarta
