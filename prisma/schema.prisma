/// Draf Pengajuan Pembimbing yang belum dikirim, satu per mahasiswa. Disimpan juga saat
/// pengajuan ditolak atau diminta revisi, supaya bisa dipakai ulang.
model ThesisSupervisorRequestDraft {
  id                   String                @id @default(uuid()) @db.VarChar(191)
  studentId            String                @unique @map("student_id") @db.VarChar(191)
  lecturerId           String?               @map("lecturer_id") @db.VarChar(191)
  topicId              String?               @map("topic_id") @db.VarChar(191)
  proposedTitle        String?               @map("proposed_title") @db.VarChar(255)
  backgroundSummary    String?               @map("background_summary") @db.Text
  problemStatement     String?               @map("problem_statement") @db.Text
  proposedSolution     String?               @map("proposed_solution") @db.Text
  researchObject       String?               @map("research_object") @db.VarChar(255)
  researchPermitStatus ResearchPermitStatus? @map("research_permit_status")
  studentJustification String?               @map("student_justification") @db.Text
  lastSubmittedAt      DateTime?             @map("last_submitted_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  student  Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lecturer Lecturer?    @relation(fields: [lecturerId], references: [id])
  topic    ThesisTopic? @relation(fields: [topicId], references: [id])

  @@index([lecturerId])
  @@index([topicId])
  @@map("thesis_supervisor_request_drafts")
}

/// Pengajuan Pembimbing (formulir TA-01/TA-02). Paling banyak satu pengajuan aktif per
/// mahasiswa. TA lahir berstatus `proposal` saat pengajuan diterima.
model ThesisSupervisorRequest {
  id                      String                        @id @default(uuid()) @db.VarChar(191)
  studentId               String                        @map("student_id") @db.VarChar(191)
  /// Dosen yang dipilih mahasiswa; kosong pada jalur departemen.
  lecturerId              String?                       @map("lecturer_id") @db.VarChar(191)
  academicYearId          String                        @map("academic_year_id") @db.VarChar(191)
  topicId                 String?                       @map("topic_id") @db.VarChar(191)
  /// Diisi saat pengajuan diterima.
  thesisId                String?                       @map("thesis_id") @db.VarChar(191)
  proposedTitle           String?                       @map("proposed_title") @db.VarChar(255)
  backgroundSummary       String?                       @map("background_summary") @db.Text
  problemStatement        String?                       @map("problem_statement") @db.Text
  proposedSolution        String?                       @map("proposed_solution") @db.Text
  researchObject          String?                       @map("research_object") @db.VarChar(255)
  researchPermitStatus    ResearchPermitStatus?         @map("research_permit_status")
  studentJustification    String?                       @map("student_justification") @db.Text
  status                  ThesisSupervisorRequestStatus @default(pending)
  route                   SupervisorRequestRoute        @default(direct)
  lecturerApprovalNote    String?                       @map("lecturer_approval_note") @db.Text
  lecturerOverquotaReason String?                       @map("lecturer_overquota_reason") @db.Text
  rejectionReason         String?                       @map("rejection_reason") @db.Text
  reviewedBy              String?                       @map("reviewed_by") @db.VarChar(191)
  reviewedAt              DateTime?                     @map("reviewed_at")
  lecturerRespondedAt     DateTime?                     @map("lecturer_responded_at")
  withdrawnAt             DateTime?                     @map("withdrawn_at")
  withdrawCount           Int                           @default(0) @map("withdraw_count")
  /// Dosen tujuan pengalihan oleh Ketua Departemen.
  redirectedTo            String?                       @map("redirected_to") @db.VarChar(191)
  kadepNotes              String?                       @map("kadep_notes") @db.Text
  forwardedToKadepAt      DateTime?                     @map("forwarded_to_kadep_at")
  forwardedByLecturerId   String?                       @map("forwarded_by_lecturer_id") @db.VarChar(191)
  /// Diterima walaupun dosen sudah di atas batas keras (disahkan Ketua Departemen).
  acceptedOverNormal      Boolean                       @default(false) @map("accepted_over_normal")
  createdAt               DateTime                      @default(now()) @map("created_at")
  updatedAt               DateTime                      @updatedAt @map("updated_at")

  student             Student      @relation(fields: [studentId], references: [id])
  lecturer            Lecturer?    @relation("SupervisorRequestTarget", fields: [lecturerId], references: [id])
  topic               ThesisTopic? @relation(fields: [topicId], references: [id])
  thesis              Thesis?      @relation(fields: [thesisId], references: [id])
  academicYear        AcademicYear @relation(fields: [academicYearId], references: [id])
  reviewer            User?        @relation("SupervisorRequestReviewer", fields: [reviewedBy], references: [id])
  redirectTarget      Lecturer?    @relation("SupervisorRequestRedirect", fields: [redirectedTo], references: [id])
  forwardedByLecturer Lecturer?    @relation("SupervisorRequestForwarder", fields: [forwardedByLecturerId], references: [id])

  @@index([studentId, status])
  @@index([lecturerId, academicYearId, status])
  @@index([academicYearId, status])
  @@index([status, createdAt])
  @@index([thesisId])
  @@index([reviewedBy])
  @@index([redirectedTo])
  @@index([forwardedByLecturerId])
  @@map("thesis_supervisor_requests")
}

/// Satu percobaan Metode Penelitian sebuah TA pada satu semester (K32): proposal final,
/// nilai pembimbing dan koordinator, kaitan presensi, dan hasilnya. Mahasiswa yang tidak
/// lulus mendapat baris baru pada semester berikutnya (K2).
/// Berkas proposal final di uploads/thesis/<thesis_id>/proposal/<assessment_id>/.
model ResearchMethodAssessment {
  id                       String                          @id @default(uuid()) @db.VarChar(191)
  thesisId                 String                          @map("thesis_id") @db.VarChar(191)
  academicYearId           String                          @map("academic_year_id") @db.VarChar(191)
  proposalFilePath         String?                         @map("proposal_file_path") @db.VarChar(255)
  proposalFileName         String?                         @map("proposal_file_name") @db.VarChar(255)
  proposalMimeType         String?                         @map("proposal_mime_type") @db.VarChar(255)
  proposalFileSize         Int?                            @map("proposal_file_size")
  proposalFileHash         String?                         @map("proposal_file_hash") @db.VarChar(255)
  proposalSubmittedAt      DateTime?                       @map("proposal_submitted_at")
  /// Pembimbing yang mengirim nilai: Pembimbing 1, atau Pembimbing 2 sebagai cadangan (K9).
  supervisorId             String?                         @map("supervisor_id") @db.VarChar(191)
  supervisorScore          Int?                            @map("supervisor_score")
  supervisorScoredAt       DateTime?                       @map("supervisor_scored_at")
  coordinatorId            String?                         @map("coordinator_id") @db.VarChar(191)
  coordinatorScore         Int?                            @map("coordinator_score")
  coordinatorScoredAt      DateTime?                       @map("coordinator_scored_at")
  /// Nilai pembimbing + nilai koordinator.
  finalScore               Int?                            @map("final_score")
  isFinalized              Boolean                         @default(false) @map("is_finalized")
  finalizedBy              String?                         @map("finalized_by") @db.VarChar(191)
  finalizedAt              DateTime?                       @map("finalized_at")
  /// Diisi saat difinalkan: lulus bila presensi memenuhi dan nilai >= nilai minimum periode.
  result                   ResearchMethodAssessmentResult?
  attendanceRecordId       String?                         @map("attendance_record_id") @db.VarChar(191)
  /// Presensi di bawah 75%: nilai otomatis 0.
  attendanceAutoZeroedAt   DateTime?                       @map("attendance_auto_zeroed_at")
  attendanceAutoZeroReason String?                         @map("attendance_auto_zero_reason") @db.Text
  createdAt                DateTime                        @default(now()) @map("created_at")
  updatedAt                DateTime                        @updatedAt @map("updated_at")

  thesis             Thesis                                      @relation(fields: [thesisId], references: [id], onDelete: Restrict)
  academicYear       AcademicYear                                @relation(fields: [academicYearId], references: [id])
  supervisor         Lecturer?                                   @relation("ResearchMethodAssessmentSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  coordinator        Lecturer?                                   @relation("ResearchMethodAssessmentCoordinator", fields: [coordinatorId], references: [id], onDelete: SetNull)
  finalizer          User?                                       @relation("ResearchMethodAssessmentFinalizer", fields: [finalizedBy], references: [id], onDelete: SetNull)
  attendanceRecord   ResearchMethodAttendanceRecord?             @relation(fields: [attendanceRecordId], references: [id], onDelete: SetNull)
  supervisorDetails  ResearchMethodSupervisorAssessmentDetail[]
  coordinatorDetails ResearchMethodCoordinatorAssessmentDetail[]

  @@unique([thesisId, academicYearId])
  @@index([academicYearId, isFinalized])
  @@index([supervisorId])
  @@index([coordinatorId])
  @@index([finalizedBy])
  @@index([attendanceRecordId])
  @@map("research_method_assessments")
}

/// Rincian nilai pembimbing per kriteria (pola `thesis_defence_supervisor_assessment_details`).
model ResearchMethodSupervisorAssessmentDetail {
  assessmentId         String   @map("assessment_id") @db.VarChar(191)
  assessmentCriteriaId String   @map("assessment_criteria_id") @db.VarChar(191)
  assessmentRubricId   String?  @map("assessment_rubric_id") @db.VarChar(191)
  score                Int
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  assessment ResearchMethodAssessment                   @relation(fields: [assessmentId], references: [id], onDelete: Cascade, map: "rm_supervisor_details_assessment_fkey")
  criteria   ResearchMethodSupervisorAssessmentCriteria @relation(fields: [assessmentCriteriaId], references: [id], onDelete: Restrict, map: "rm_supervisor_details_criteria_fkey")
  rubric     ResearchMethodSupervisorAssessmentRubric?  @relation(fields: [assessmentRubricId], references: [id], onDelete: SetNull, map: "rm_supervisor_details_rubric_fkey")

  @@id([assessmentId, assessmentCriteriaId])
  @@index([assessmentCriteriaId], map: "rm_supervisor_details_criteria_id_idx")
  @@index([assessmentRubricId], map: "rm_supervisor_details_rubric_id_idx")
  @@map("research_method_supervisor_assessment_details")
}

