  @@index([yudisiumId], map: "yudisium_participants_yudisium_id_fkey")
  @@index([yudisiumId, exitSurveyFormId], map: "yudisium_participants_yudisium_form_id_fkey")
  @@index([exitSurveyFormId], map: "yudisium_participants_exit_survey_form_id_fkey")
  @@map("yudisium_participants")
}

model YudisiumParticipantRequirement {
  yudisiumParticipantId String @map("yudisium_participant_id") @db.VarChar(255)

  yudisiumRequirementItemId String @map("yudisium_requirement_item_id") @db.VarChar(255)

  yudisiumId String @map("yudisium_id") @db.VarChar(255)

  verifiedBy String? @map("verified_by") @db.VarChar(255)

  filePath String @map("file_path") @db.VarChar(255)

  fileName String @map("file_name") @db.VarChar(255)

  mimeType String @map("mime_type") @db.VarChar(255)

  fileSize Int @map("file_size")

  fileHash String? @map("file_hash") @db.VarChar(255)

  submittedAt DateTime @map("submitted_at")

