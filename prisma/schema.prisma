/// Thesis = shared container antara SIMPTA (proposal phase, isProposal=true)
/// dan Modul Tugas Akhir penuh (isProposal=false, post-promosi aktif setelah
/// TA-03 final + snapshot KRS TA true; bukan hanya karena TA-04 terbit).
/// Lihat HANDOFF_SCHEMA_SIMPTA_REVISI.md §5 P0-06 untuk field ownership matrix.
model Thesis {
  // === IDENTITAS & STATUS ===
  id                 String                   @id @default(uuid())
  studentId          String                   @map("student_id")
  thesisTopicId      String?                  @map("thesis_topic_id")
  /// Status siklus hidup TA (K15), satu-satunya penanda fase. Wajib diisi eksplisit
  /// oleh setiap penulis (tanpa default): `proposal` = fase proposal, `research` = fase TA.
  status             ThesisLifecycleStatus    @map("status")
  statusChangedAt    DateTime?                @map("status_changed_at")
  /// Penghentian TA (status `failed`). Kolom disiapkan; fiturnya belum dibuat.
  terminationReason  ThesisTerminationReason? @map("termination_reason")
  terminationNote    String?                  @map("termination_note") @db.Text
  terminatedAt       DateTime?                @map("terminated_at")
  terminatedByUserId String?                  @map("terminated_by_user_id")
  /// Berhenti Studi Sementara (status `on_leave`): status sebelumnya dan tanggal mulai.
  statusBeforeLeave  ThesisLifecycleStatus?   @map("status_before_leave")
  leaveStartedAt     DateTime?                @map("leave_started_at")
  /// Jumlah hari cuti (BSS) yang sudah selesai. Ditambah saat TA kembali dari `on_leave`,
  /// supaya masa bimbingan (dihitung dari `startDate`) tidak menghitung masa cuti.
  totalLeaveDays     Int                      @default(0) @map("total_leave_days")
  /// Periode saat TA lahir (pengajuan pembimbing diterima).
  academicYearId     String?                  @map("academic_year_id")
  title              String?                  @db.Text
  startDate          DateTime?                @map("start_date")

  /// Waktu Penetapan Pembimbing pertama (formulir TA-04), menggantikan kolom `ta04_assignment_*`.
  /// Membuka bimbingan proposal dan pengajuan proposal final (K3: tanpa lapisan reservasi).
  supervisorAssignedAt DateTime? @map("supervisor_assigned_at")

  createdAt                  DateTime                                @default(now()) @map("created_at")
  updatedAt                  DateTime                                @updatedAt @map("updated_at")
  // Relations
  academicYear               AcademicYear?                           @relation(fields: [academicYearId], references: [id])
  student                    Student                                 @relation(fields: [studentId], references: [id])
  terminatedBy               User?                                   @relation("ThesisTerminatedBy", fields: [terminatedByUserId], references: [id], onDelete: SetNull)
  thesisTopic                ThesisTopic?                            @relation(fields: [thesisTopicId], references: [id])
  thesisGuidanceEvaluations  ThesisGuidanceEvaluation[]
  thesisChangeRequests       ThesisChangeRequest[]
  thesisDefences             ThesisDefence[]
  thesisGuidances            ThesisGuidance[]
  thesisMilestones           ThesisMilestone[]
  thesisSupervisors          ThesisSupervisors[]
  thesisSeminars             ThesisSeminar[]
  yudisiumParticipants       YudisiumParticipant[]
  studentExitSurveyResponses StudentExitSurveyResponse[]
  researchMethodAssessments  ResearchMethodAssessment[]
  supervisorRequests         ThesisSupervisorRequest[]
  supervisorAssignments      ThesisSupervisorAssignmentBatchMember[]

  @@index([academicYearId], map: "thesis_academic_year_id_fkey")
  @@index([studentId], map: "thesis_student_id_fkey")
  @@index([thesisTopicId], map: "thesis_thesis_topic_id_fkey")
  @@index([terminatedByUserId], map: "thesis_terminated_by_user_id_fkey")
  @@index([status])
  @@index([studentId, status])
  @@map("thesis")
}

/// Penetapan Pembimbing satu periode (formulir TA-04). PDF batch disimpan di baris ini
/// dan menjadi bukti beku susunan judul dan pembimbing (10.4).
model ThesisSupervisorAssignmentBatch {
  id                String   @id @default(uuid())
  academicYearId    String   @map("academic_year_id")
  version           Int      @default(1)
  /// Nilai: current, superseded.
  status            String   @default("current") @db.VarChar(32)
  cohortHash        String   @map("cohort_hash") @db.VarChar(64)
  generatedByUserId String?  @map("generated_by_user_id")
  generatedAt       DateTime @default(now()) @map("generated_at")
  filePath          String   @map("file_path") @db.VarChar(255)
  fileName          String   @map("file_name") @db.VarChar(255)
  mimeType          String   @map("mime_type") @db.VarChar(255)
  fileSize          Int      @map("file_size")
  fileHash          String?  @map("file_hash") @db.VarChar(255)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  academicYear AcademicYear                            @relation(fields: [academicYearId], references: [id])
  generatedBy  User?                                   @relation("SupervisorAssignmentBatchGeneratedBy", fields: [generatedByUserId], references: [id], onDelete: SetNull)
  members      ThesisSupervisorAssignmentBatchMember[]

  @@unique([academicYearId, version])
  @@index([academicYearId, status])
  @@index([generatedByUserId])
  @@map("thesis_supervisor_assignment_batches")
}

/// Anggota penetapan: hanya merujuk TA. Nama dan judul diambil dari data hidup;
/// salinan bekunya ada di PDF batch.
model ThesisSupervisorAssignmentBatchMember {
  id        String   @id @default(uuid())
  batchId   String   @map("batch_id")
  thesisId  String   @map("thesis_id")
  createdAt DateTime @default(now()) @map("created_at")

  batch  ThesisSupervisorAssignmentBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  thesis Thesis                          @relation(fields: [thesisId], references: [id])

  @@unique([batchId, thesisId])
  @@index([thesisId])
  @@map("thesis_supervisor_assignment_batch_members")
}

/// Pengajuan Perubahan Tugas Akhir (formulir TA-05, keputusan K8): perubahan judul dan/atau
/// satu posisi pembimbing untuk TA fase penelitian. Keadaan pengajuan disimpan di sini,
/// bukan di notifikasi. Mesin ini juga dipakai "Alihkan Mahasiswa" (`batchId` sama).
model ThesisChangeRequest {
  id                           String                        @id @default(uuid())
  thesisId                     String?                       @map("thesis_id")
  requestType                  ThesisChangeRequestType       @map("request_type")
  reason                       String                        @db.Text
  status                       ThesisChangeRequestStatus     @default(pending)
  /// Pengaju: mahasiswa pemilik TA atau dosen pembimbingnya.
  requestedByUserId            String?                       @map("requested_by_user_id")
  /// Sama untuk pengajuan yang dibuat sekaligus lewat "Alihkan Mahasiswa".
  batchId                      String?                       @map("batch_id")
  /// Perubahan judul: judul baru, topik baru (opsional), dan salinan judul saat diajukan.
  previousTitle                String?                       @map("previous_title") @db.Text
  newTitle                     String?                       @map("new_title") @db.Text
  newTopicId                   String?                       @map("new_topic_id")
  /// Perubahan pembimbing, satu posisi per pengajuan. `replacedSupervisorLecturerId`
  /// kosong berarti menambah ke posisi yang masih kosong.
  supervisorRole               ThesisSupervisorPosition?     @map("supervisor_role")
  replacedSupervisorLecturerId String?                       @map("replaced_supervisor_lecturer_id")
  newSupervisorId              String?                       @map("new_supervisor_id")
  /// Penutupan pengajuan: keputusan Kadep, penolakan dosen, atau pembatalan pengaju.
  decidedByUserId              String?                       @map("decided_by_user_id")
  decisionNotes                String?                       @map("decision_notes") @db.Text
  decidedAt                    DateTime?                     @map("decided_at")
  /// Diisi saat perubahan sudah diterapkan ke TA (pengajuan disetujui Kadep).
  appliedAt                    DateTime?                     @map("applied_at")
  createdAt                    DateTime                      @default(now()) @map("created_at")
  updatedAt                    DateTime                      @updatedAt @map("updated_at")
  approvals                    ThesisChangeRequestApproval[]
  thesis                       Thesis?                       @relation(fields: [thesisId], references: [id])
  requestedBy                  User?                         @relation("ChangeRequestRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  decidedBy                    User?                         @relation("ChangeRequestDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  newTopic                     ThesisTopic?                  @relation("ChangeRequestNewTopic", fields: [newTopicId], references: [id])
  newSupervisor                Lecturer?                     @relation("ChangeRequestNewSupervisor", fields: [newSupervisorId], references: [id], onDelete: SetNull)
  replacedSupervisor           Lecturer?                     @relation("ChangeRequestReplacedSupervisor", fields: [replacedSupervisorLecturerId], references: [id], onDelete: SetNull)

  @@index([thesisId, status])
  @@index([status])
  @@index([batchId])
  @@index([requestedByUserId])
  @@index([decidedByUserId])
  @@index([newTopicId])
  @@index([newSupervisorId])
  @@index([replacedSupervisorLecturerId])
  @@map("thesis_change_requests")
}

/// Langkah persetujuan dosen pada sebuah pengajuan perubahan, berurutan menurut `stepOrder`.
model ThesisChangeRequestApproval {
  id         String                   @id @default(uuid())
  requestId  String                   @map("request_id")
  lecturerId String                   @map("lecturer_id")
  /// Sebagai apa dosen ini menyetujui.
  role       ThesisChangeApprovalRole
  stepOrder  Int                      @default(1) @map("step_order")
  status     ApprovalStatus           @default(pending)
  notes      String?                  @db.Text
  decidedAt  DateTime?                @map("decided_at")
  createdAt  DateTime                 @default(now()) @map("created_at")
  updatedAt  DateTime                 @updatedAt @map("updated_at")
  lecturer   Lecturer                 @relation(fields: [lecturerId], references: [id])
  request    ThesisChangeRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, role])
  @@index([lecturerId, status])
  @@index([requestId, stepOrder])
  @@map("thesis_change_request_approvals")
}

model ThesisSupervisors {
  id String @id @default(uuid())

  thesisId String @map("thesis_id")

  lecturerId String @map("lecturer_id")

  roleId String @map("role_id")

  seminarReady Boolean @default(false) @map("seminar_ready")

  defenceReady Boolean @default(false) @map("defence_ready")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  lecturer Lecturer @relation(fields: [lecturerId], references: [id])

  role UserRole @relation(fields: [roleId], references: [id])

  thesis Thesis @relation(fields: [thesisId], references: [id])

  thesisSeminarAudienceApprovals ThesisSeminarAudience[]

  thesisSeminarRevisionApprovals ThesisSeminarRevision[]

  thesisSeminarResultFinalizations ThesisSeminar[] @relation("SeminarResultFinalizedBy")

  thesisSeminarRevisionFinalizations ThesisSeminar[] @relation("SeminarRevisionFinalizedBy")

  thesisDefenceResultFinalizations ThesisDefence[] @relation("DefenceResultFinalizedBy")

  thesisDefenceRevisionFinalizations ThesisDefence[] @relation("DefenceRevisionFinalizedBy")

  thesisDefenceRevisionApprovals ThesisDefenceRevision[]

  status              SupervisorStatus           @default(active)
  activeRoleKey       String?                    @unique @map("active_role_key") @db.VarChar(191)
  guidanceEvaluations ThesisGuidanceEvaluation[]

  @@unique([id, thesisId])
  @@index([lecturerId], map: "thesis_participants_lecturer_id_fkey")
  @@index([roleId], map: "thesis_participants_role_id_fkey")
  @@index([thesisId], map: "thesis_participants_thesis_id_fkey")
  @@index([thesisId, roleId, status])
  @@map("thesis_supervisors")
}

/// Evaluasi Bimbingan (formulir TA-17). Diisi Pembimbing 1 saat masa bimbingan mencapai
/// 6 bulan atau 1 tahun; rekomendasi selain "lanjut bimbingan" diputuskan Ketua Departemen.
model ThesisGuidanceEvaluation {
  id                   String                           @id @default(uuid())
  thesisId             String                           @map("thesis_id")
  thesisSupervisorId   String                           @map("thesis_supervisor_id")
  evaluationType       GuidanceEvaluationType           @map("evaluation_type")
  /// Tindak lanjut evaluasi 6 bulan, diisi setelah perpanjangan 1 bulan berakhir.
  isFollowUp           Boolean                          @default(false) @map("is_follow_up")
  /// Hasil observasi pembimbing (boleh lebih dari satu).
  observedNoGuidance   Boolean                          @default(false) @map("observed_no_guidance")
  observedNoProgress   Boolean                          @default(false) @map("observed_no_progress")
  observedNoResponse   Boolean                          @default(false) @map("observed_no_response")
  observedNoRevision   Boolean                          @default(false) @map("observed_no_revision")
  notes                String?                          @db.Text
  /// Dasar evaluasi, disalin saat formulir diisi.
  guidanceCount        Int                              @default(0) @map("guidance_count")
  supervisionStartedAt DateTime?                        @map("supervision_started_at")
  elapsedDays          Int?                             @map("elapsed_days")
  recommendation       GuidanceEvaluationRecommendation
  status               GuidanceEvaluationStatus         @default(pending)
  kadepApprovedBy      String?                          @map("kadep_approved_by")
  kadepApprovedAt      DateTime?                        @map("kadep_approved_at")
  kadepNotes           String?                          @map("kadep_notes") @db.Text
  /// Batas perpanjangan: tanggal keputusan + 1 bulan (rekomendasi `extend_1_month`).
  extensionUntil       DateTime?                        @map("extension_until")
  createdAt            DateTime                         @default(now()) @map("created_at")
  updatedAt            DateTime                         @updatedAt @map("updated_at")
  thesis               Thesis                           @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  thesisSupervisor     ThesisSupervisors                @relation(fields: [thesisSupervisorId], references: [id], onDelete: Cascade)
  kadepApprover        User?                            @relation("GuidanceEvalKadepApprover", fields: [kadepApprovedBy], references: [id], onDelete: SetNull)

  @@index([thesisId])
  @@index([thesisSupervisorId])
  @@index([status])
  @@map("thesis_guidance_evaluations")
}

model ThesisTopic {
  id             String   @id @default(uuid())
  name           String
  scienceGroupId String?  @map("science_group_id")
  lecturerId     String?  @map("lecturer_id")
  description    String?  @db.Text
  isPublished    Boolean  @default(false) @map("is_published")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  scienceGroup            ScienceGroup?                  @relation(fields: [scienceGroupId], references: [id])
  lecturer                Lecturer?                      @relation("TopicOfferedByLecturer", fields: [lecturerId], references: [id])
  thesis                  Thesis[]
  milestoneTemplates      ThesisMilestoneTemplate[]
  supervisorRequests      ThesisSupervisorRequest[]
  supervisorRequestDrafts ThesisSupervisorRequestDraft[]
  changeRequestsNewTopic  ThesisChangeRequest[]          @relation("ChangeRequestNewTopic")

  @@index([scienceGroupId])
  @@index([lecturerId])
  @@map("thesis_topics")
}

// ThesisProposal model removed — fields merged into Thesis

/// Template milestone kedua fase (K18): fase proposal berlaku umum (`topic_id` NULL),
/// fase penelitian per topik.
model ThesisMilestoneTemplate {
  id               String      @id @default(uuid())
  name             String
  description      String?     @db.Text
  topicId          String?     @map("topic_id")
  /// Wajib, tanpa default (K18). Template proposal berlaku umum (topicId NULL); template TA per topik.
  phase            ThesisPhase
  orderIndex       Int         @default(0) @map("order_index")
  isActive         Boolean     @default(true) @map("is_active")
  defaultDueDays   Int?        @map("default_due_days")
  defaultDueDate   DateTime?   @map("default_due_date")
  weightPercentage Int?        @map("weight_percentage")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  topic      ThesisTopic?      @relation(fields: [topicId], references: [id])
  milestones ThesisMilestone[]

  @@index([topicId], map: "thesis_milestone_templates_topic_id_fkey")
  @@index([phase])
  @@map("thesis_milestone_templates")
}

model ThesisMilestone {
  id                  String  @id @default(uuid())
  thesisId            String  @map("thesis_id")
  milestoneTemplateId String? @map("milestone_template_id")

  title              String
  description        String?         @db.Text
  orderIndex         Int             @default(0) @map("order_index")
  targetDate         DateTime?       @map("target_date")
  startedAt          DateTime?       @map("started_at")
  completedAt        DateTime?       @map("completed_at")
  submittedAt        DateTime?       @map("submitted_at")
  status             MilestoneStatus @default(not_started)
  /// Ditetapkan server dari status TA saat milestone dibuat (K6). Tanpa default.
  phase              ThesisPhase
  progressPercentage Int             @default(0) @map("progress_percentage")

  validatedBy     String?   @map("validated_by")
  validatedAt     DateTime? @map("validated_at")
  supervisorNotes String?   @map("supervisor_notes") @db.Text
  studentNotes    String?   @map("student_notes") @db.Text
  feedback        String?   @db.Text
  /// Feedback pembimbing (P1/P2), terpisah dari catatan keputusan `supervisorNotes` (Paket C, C9).
  /// Feedback baru menggantikan yang lama; riwayat ada di notifikasi dan audit log.
  feedbackBy      String?   @map("feedback_by")
  feedbackAt      DateTime? @map("feedback_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  thesis             Thesis                    @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  milestoneTemplate  ThesisMilestoneTemplate?  @relation(fields: [milestoneTemplateId], references: [id])
  guidances          ThesisGuidanceMilestone[]
  milestoneDocuments ThesisMilestoneDocument[]

  @@index([thesisId, orderIndex])
  @@index([thesisId, status])
  @@index([thesisId, phase])
  @@index([milestoneTemplateId])
  @@map("thesis_milestones")
}

model ThesisGuidanceMilestone {
  guidanceId  String @map("guidance_id")
  milestoneId String @map("milestone_id")

  guidance  ThesisGuidance  @relation(fields: [guidanceId], references: [id], onDelete: Cascade)
  milestone ThesisMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@id([guidanceId, milestoneId])
  @@index([milestoneId])
  @@map("thesis_guidance_milestones")
}

model ThesisMilestoneDocument {
  id          String   @id @default(uuid())
  milestoneId String   @map("milestone_id")
  filePath    String?  @map("file_path")
  fileName    String?  @map("file_name")
  fileSize    Int?     @map("file_size")
  mimeType    String?  @map("mime_type")
  description String?  @db.Text
  version     Int      @default(1)
  isLatest    Boolean  @default(true) @map("is_latest")
  createdAt   DateTime @default(now()) @map("created_at")

  milestone ThesisMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
  @@map("thesis_milestone_documents")
}

model ThesisGuidance {
  id           String  @id @default(uuid())
  thesisId     String  @map("thesis_id")
  supervisorId String? @map("supervisor_id")

  requestedDate DateTime  @map("requested_date")
  approvedDate  DateTime? @map("approved_date")
  duration      Int       @default(60)

  documentUrl        String? @map("document_url")
  studentNotes       String? @map("student_notes") @db.Text
  supervisorFeedback String? @map("supervisor_feedback") @db.Text
  rejectionReason    String? @map("rejection_reason") @db.Text
  sessionSummary     String? @map("session_summary") @db.Text
  actionItems        String? @map("action_items") @db.Text

  summarySubmittedAt DateTime? @map("summary_submitted_at")
  completedAt        DateTime? @map("completed_at")

  /// K19: waktu alternatif yang diusulkan dosen saat menolak (opsional).
  suggestedDate    DateTime?      @map("suggested_date")
  /// K19: perubahan jadwal oleh dosen setelah `accepted` (riwayat lengkap di audit log).
  rescheduleReason String?        @map("reschedule_reason") @db.Text
  rescheduledAt    DateTime?      @map("rescheduled_at")
  /// K19: pembatalan oleh mahasiswa, dosen, atau sistem (penghentian TA), dengan alasan.
