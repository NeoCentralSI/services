/// Cakupan form penilaian yang memakai AssessmentCriteria.
/// Sumber: canon §5.7 + §5.7.4 + HANDOFF §5 P1-09.
///
/// SIMPTA scope (rows yang relevan untuk Penilaian Proposal):
/// - `proposal` = TA-03A (Penilaian Proposal oleh Pembimbing, maks 75 poin).
///                CPMK-01 Presentasi (20) + CPMK-02 Konten (40) + CPMK-03 Respons (15).
/// - `metopen`  = TA-03B (Penilaian Proposal oleh Koordinator Matkul Metopen, maks 25 poin).
///                CPMK-02 Proposal struktur (25, role=default).
///
/// Out-of-SIMPTA scope (modul TA penuh):
/// - `seminar`  = Penilaian Seminar Hasil (TA-08 / modul TA penuh, BUKAN SIMPTA).
/// - `defence`  = Penilaian Sidang (modul TA penuh, BUKAN SIMPTA).
///
/// Service `assessment.service.js` yang menulis TA-03A wajib pakai
/// `appliesTo='proposal'`; TA-03B pakai `appliesTo='metopen'`. Filter
/// `appliesTo IN ('proposal', 'metopen')` saat fetch criteria SIMPTA.
enum AssessmentAppliesTo {
  seminar
  defence
  proposal
  metopen
}

/// Status enum lifecycle pengajuan pembimbing. Canon §5.2 + skill system-design.
/// === ACTIVE STATES (canon-aligned) ===
/// pending, under_review, pending_kadep, booking_approved, active_official,
/// released, revision_requested, rejected_by_dosen, rejected_by_kadep, redirected,
/// withdrawn, canceled, closed.
/// `closed` kanonis untuk pra-booking yang ditutup sistem saat periode Metopel
/// berakhir (BR-29 / canon §5.7.5). Bukan cabut mahasiswa (`canceled`).
/// === LEGACY (deprecated, read-only untuk backward compat) ===
/// approved, rejected, override_approved, assigned, escalated.
/// Service layer baru WAJIB pakai canonical states; legacy hanya untuk read
/// historical rows. Backfill di migration B sudah konversi rows aktif ke
/// canonical state. Sumber: HANDOFF_SCHEMA_SIMPTA_REVISI.md §5 P0-03.
enum ThesisAdvisorRequestStatus {
  // === ACTIVE STATES (canon-aligned) ===
  pending
  under_review
  pending_kadep
  booking_approved
  active_official
  released
  revision_requested
  rejected_by_dosen
  rejected_by_kadep
  redirected
  withdrawn
  canceled
  closed
  // === LEGACY (deprecated — JANGAN ditulis service baru) ===
  /// @deprecated Use `pending_kadep` + `routeType=escalated` instead.
  escalated
  /// @deprecated Use `booking_approved` instead.
  approved
  /// @deprecated Use `rejected_by_dosen` atau `rejected_by_kadep` instead.
  rejected
  /// @deprecated Use `booking_approved` + `acceptedOverNormal=true` instead.
  override_approved
  /// @deprecated Use `active_official` instead.
  assigned
}

/// 3-path routing canon §5.2 + BPMN Diagram 2 Gateway_TargetOverload.
/// Path A=dept (TA-02), Path B=normal (TA-01 kuota hijau/kuning),
/// Path C=escalated (TA-01 kuota merah + mahasiswa kokoh).
enum AdvisorRequestRoute {
  normal // Path B: TA-01 normal (kuota dosen hijau/kuning)
  escalated // Path C: TA-01 escalated (kuota dosen merah, mahasiswa kokoh)
  dept // Path A: TA-02 (jalur departemen, mahasiswa belum punya calon)
}

