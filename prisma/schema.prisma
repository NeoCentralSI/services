/// Unggahan berkas presensi kelas Metode Penelitian (10.5). Berkas sumber di
/// uploads/research-method/attendance/<import_id>/, dicatat di `source_files`.
model ResearchMethodAttendanceImport {
  id                    String   @id @default(uuid()) @db.VarChar(191)
  academicYearId        String   @map("academic_year_id") @db.VarChar(191)
  uploadedByUserId      String   @map("uploaded_by_user_id")
  classCode             String?  @map("class_code") @db.VarChar(100)
  courseName            String?  @map("course_name") @db.VarChar(255)
  semesterLabel         String?  @map("semester_label") @db.VarChar(100)
  filterLabel           String?  @map("filter_label") @db.VarChar(100)
  lecturerNames         Json?    @map("lecturer_names")
  /// [{ originalName, classCode, filePath, fileHash, fileSize }, ...]
  sourceFiles           Json?    @map("source_files")
  thresholdPercent      Float    @default(0.75) @map("threshold_percent")
  totalRows             Int      @default(0) @map("total_rows")
  matchedRows           Int      @default(0) @map("matched_rows")
  eligibleRows          Int      @default(0) @map("eligible_rows")
  ineligibleRows        Int      @default(0) @map("ineligible_rows")
  autoZeroedCount       Int      @default(0) @map("auto_zeroed_count")
  skippedFinalizedCount Int      @default(0) @map("skipped_finalized_count")
  uploadedAt            DateTime @default(now()) @map("uploaded_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  academicYear AcademicYear                     @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  uploadedBy   User                             @relation("ResearchMethodAttendanceImportUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  records      ResearchMethodAttendanceRecord[]

  @@index([academicYearId, uploadedAt])
  @@index([uploadedByUserId])
  @@map("research_method_attendance_imports")
}

/// Satu baris presensi dari berkas yang diunggah. Nama mahasiswa diambil dari `students`;
/// nama di berkas tetap ada di `raw_row` untuk baris yang tidak cocok dengan mahasiswa mana pun.
model ResearchMethodAttendanceRecord {
  id                   String   @id @default(uuid()) @db.VarChar(191)
  importId             String   @map("import_id") @db.VarChar(191)
  studentId            String?  @map("student_id")
  identityNumber       String   @map("identity_number") @db.VarChar(50)
  presentCount         Int      @default(0) @map("present_count")
  absentCount          Int      @default(0) @map("absent_count")
  sickCount            Int      @default(0) @map("sick_count")
  permitCount          Int      @default(0) @map("permit_count")
  totalMeetings        Int      @default(0) @map("total_meetings")
  attendancePercentage Float    @map("attendance_percentage")
  isEligible           Boolean  @map("is_eligible")
  rawRow               Json?    @map("raw_row")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  import      ResearchMethodAttendanceImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  student     Student?                       @relation(fields: [studentId], references: [id], onDelete: SetNull)
  assessments ResearchMethodAssessment[]

  @@unique([importId, identityNumber])
  @@index([identityNumber])
  @@index([studentId])
  @@map("research_method_attendance_records")
}

