// ==================== Research Method Scores ====================
model ResearchMethodScore {
  id                       String    @id @default(uuid()) @db.VarChar(191)
  thesisId                 String    @unique @map("thesis_id") @db.VarChar(191)
  supervisorId             String?   @map("supervisor_id") @db.VarChar(191)
  supervisorScore          Int?      @map("supervisor_score")
  lecturerId               String?   @map("lecturer_id") @db.VarChar(191)
  lecturerScore            Int?      @map("lecturer_score")
  finalScore               Int?      @map("final_score")
  isFinalized              Boolean   @default(false) @map("is_finalized")
  finalizedBy              String?   @map("finalized_by") @db.VarChar(191)
  finalizedAt              DateTime? @map("finalized_at")
  calculatedAt             DateTime? @map("calculated_at")
  attendanceRecordId       String?   @map("attendance_record_id") @db.VarChar(191)
  attendanceAutoZeroedAt   DateTime? @map("attendance_auto_zeroed_at")
  attendanceAutoZeroReason String?   @map("attendance_auto_zero_reason") @db.Text
  // BR-29 (canon v3.4 §5.7.5): tutup periode Metopel. Terpisah dari auto-zero presensi.
  periodClosedAt           DateTime? @map("period_closed_at")
  periodClosedReason       String?   @map("period_closed_reason") @db.VarChar(64)
  // BR-20 (canon §5.7.1): TA-03A konsensus P1 master + P2 co-sign.
  // P1 mengisi rubrik utuh (supervisorScore + supervisorId di atas);
  // P2 melakukan co-sign sebagai persetujuan tanpa modifikasi nilai.
  // Field opsional — bila thesis hanya punya 1 pembimbing (P1 saja),
  // co-sign di-skip dan field-field ini tetap null.
  coSignedByLecturerId     String?   @map("co_signed_by_lecturer_id") @db.VarChar(191)
  coSignedAt               DateTime? @map("co_signed_at")
  coSignNote               String?   @map("co_sign_note") @db.Text
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  // Restrict: hapus thesis tidak boleh menghapus jejak nilai TA-03 (BR-21 / audit).
  thesis                     Thesis                      @relation(fields: [thesisId], references: [id], onDelete: Restrict)
  supervisor                 Lecturer?                   @relation("ResearchMethodScoreSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  lecturerAssessor           Lecturer?                   @relation("ResearchMethodScoreLecturer", fields: [lecturerId], references: [id], onDelete: SetNull)
  coSigner                   Lecturer?                   @relation("ResearchMethodScoreCoSigner", fields: [coSignedByLecturerId], references: [id], onDelete: SetNull)
  finalizer                  User?                       @relation("ResearchMethodScoreFinalizer", fields: [finalizedBy], references: [id], onDelete: SetNull)
  attendanceRecord           MetopenAttendanceRecord?    @relation("ResearchMethodAttendanceRecord", fields: [attendanceRecordId], references: [id], onDelete: SetNull)
  researchMethodScoreDetails ResearchMethodScoreDetail[]

  @@index([supervisorId])
  @@index([lecturerId])
  @@index([isFinalized])
  @@index([coSignedByLecturerId])
  @@index([finalizedBy])
  @@index([attendanceRecordId])
  @@index([periodClosedAt])
  @@map("research_method_scores")
}

model ResearchMethodScoreDetail {
  researchMethodScoreId String   @map("research_method_score_id") @db.VarChar(191)
  assessmentCriteriaId  String   @map("assessment_criteria_id") @db.VarChar(191)
  assessmentRubricId    String?  @map("assessment_rubric_id") @db.VarChar(191)
