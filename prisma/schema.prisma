  lecturerOverquotaReason String?                    @map("lecturer_overquota_reason") @db.Text
  rejectionReason         String?                    @map("rejection_reason") @db.Text
  reviewedBy              String?                    @map("reviewed_by") @db.VarChar(191)
  reviewedAt              DateTime?                  @map("reviewed_at")
  lecturerRespondedAt     DateTime?                  @map("lecturer_responded_at")
  withdrawnAt             DateTime?                  @map("withdrawn_at")
  releasedAt              DateTime?                  @map("released_at")
  releaseReason           String?                    @map("release_reason") @db.VarChar(64)
  releasedAcademicYearId  String?                    @map("released_academic_year_id") @db.VarChar(191)
  withdrawCount           Int                        @default(0) @map("withdraw_count")
  redirectedTo            String?                    @map("redirected_to") @db.VarChar(191)
  kadepNotes              String?                    @map("kadep_notes") @db.Text
  attachmentId            String?                    @map("attachment_id") @db.VarChar(191) // TA-01 or Draft Proposal
  // BR-26 Path C dual-justification audit (canon §5.2.1).
  // forwardedToKadepAt + forwardedByLecturerId menandai kapan/oleh siapa dosen
  // forward overquota request ke KaDep. Wajib di-set bersamaan dengan
  // lecturerOverquotaReason di service `advisorRequest.forwardOverquotaToKadep`.
  forwardedToKadepAt      DateTime?                  @map("forwarded_to_kadep_at")
  forwardedByLecturerId   String?                    @map("forwarded_by_lecturer_id") @db.VarChar(191)
  // BR-06 + canon §7.3: flag eksplisit untuk computed "Overquota Sah".
  // Di-set true saat KaDep override Path C escalated → status=booking_approved.
  // Hindari computed gabungan routeType+status yang fragile.
  acceptedOverNormal      Boolean                    @default(false) @map("accepted_over_normal")
  createdAt               DateTime                   @default(now()) @map("created_at")
  updatedAt               DateTime                   @updatedAt @map("updated_at")

  student              Student       @relation(fields: [studentId], references: [id])
  lecturer             Lecturer?     @relation("AdvisorRequestTarget", fields: [lecturerId], references: [id])
  topic                ThesisTopic?  @relation(fields: [topicId], references: [id])
  thesis               Thesis?       @relation(fields: [thesisId], references: [id])
  academicYear         AcademicYear  @relation(fields: [academicYearId], references: [id])
  releasedAcademicYear AcademicYear? @relation("AdvisorRequestReleasedAcademicYear", fields: [releasedAcademicYearId], references: [id])
  reviewer             User?         @relation("AdvisorRequestReviewer", fields: [reviewedBy], references: [id])
  redirectTarget       Lecturer?     @relation("AdvisorRequestRedirect", fields: [redirectedTo], references: [id])
  forwardedByLecturer  Lecturer?     @relation("AdvisorRequestForwarder", fields: [forwardedByLecturerId], references: [id])
  attachment           Document?     @relation("AdvisorRequestAttachment", fields: [attachmentId], references: [id])

  @@index([studentId])
  @@index([studentId, status])
  @@index([lecturerId])
  @@index([lecturerId, academicYearId, status])
  @@index([academicYearId, status])
  @@index([thesisId])
  @@index([status, createdAt])
  @@index([status])
  @@index([releasedAcademicYearId])
  @@index([reviewedBy])
  @@index([redirectedTo])
  @@index([forwardedByLecturerId])
  @@index([attachmentId])
  @@map("thesis_advisor_request")
}

