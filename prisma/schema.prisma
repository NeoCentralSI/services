  assessmentRubric    MetopenAssessmentRubric?  @relation(fields: [assessmentRubricId], references: [id], onDelete: SetNull)

  @@id([researchMethodScoreId, assessmentCriteriaId])
  @@index([assessmentCriteriaId], map: "research_method_score_details_criteria_id_fkey")
  @@index([assessmentRubricId], map: "research_method_score_details_rubric_id_fkey")
  @@map("research_method_score_details")
}

