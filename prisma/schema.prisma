generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String              @id @default(uuid())
  fullName                   String              @map("full_name")
  identityNumber             String              @unique @map("identity_number")
  identityType               IdentityType        @map("identity_type")
  email                      String?             @unique
  password                   String?
  phoneNumber                String?             @map("phone_number")
  isVerified                 Boolean             @default(false)
  token                      String?             @db.Text
  refreshToken               String?             @map("refresh_token") @db.Text
  oauthProvider              String?             @map("oauth_provider")
  oauthId                    String?             @map("oauth_id")
  oauthRefreshToken          String?             @map("oauth_refresh_token") @db.Text
  avatarUrl                  String?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  documents                  Document[]          @relation("UploadedDocuments")
  internshipSeminarApprovals InternshipSeminar[] @relation("InternshipSeminarApprover")
  lecturer                   Lecturer?
  notifications              Notification[]
  student                    Student?
  userHasRoles               UserHasRole[]

  cplScoresInputBy                   StudentCplScore[]                  @relation("CplScoreInputBy")
  cplScoresVerifiedBy                StudentCplScore[]                  @relation("CplScoreVerifiedBy")
  yudisiumReqVerifications           YudisiumParticipantRequirement[]   @relation("YudisiumReqVerifiedBy")
  yudisiumCplRecsCreated             YudisiumCplRecommendation[]        @relation("YudisiumCplRecCreatedBy")
  yudisiumCplRecsResolved            YudisiumCplRecommendation[]        @relation("YudisiumCplRecResolvedBy")
  yudisiumDecreeUploads              Yudisium[]                         @relation("YudisiumDecreeUploader")
  seminarExaminerAssignments         ThesisSeminarExaminer[]            @relation("SeminarExaminerAssignedBy")
  seminarDocVerifications            ThesisSeminarDocument[]            @relation("SeminarDocVerifiedBy")
  seminarRequirementDocVerifications ThesisSeminarRequirementDocument[] @relation("SeminarRequirementDocVerifiedBy")
  defenceExaminerAssignments         ThesisDefenceExaminer[]            @relation("DefenceExaminerAssignedBy")
  defenceDocVerifications            ThesisDefenceDocument[]            @relation("DefenceDocVerifiedBy")
  defenceRequirementDocVerifications ThesisDefenceRequirementDocument[] @relation("DefenceRequirementDocVerifiedBy")
  advisorRequestsReviewed            ThesisAdvisorRequest[]             @relation("AdvisorRequestReviewer")
  guidanceEvaluationsApproved        ThesisGuidanceEvaluation[]         @relation("GuidanceEvalKadepApprover")
  proposalTitleReviews               Thesis[]                           @relation("ThesisProposalReviewedBy")
  ta04AssignmentsIssued              Thesis[]                           @relation("ThesisTa04AssignmentIssuedBy")
  researchMethodScoresFinalized      ResearchMethodScore[]              @relation("ResearchMethodScoreFinalizer")
  metopenAttendanceImportsUploaded   MetopenAttendanceImport[]          @relation("MetopenAttendanceImportUploader")
  proposalVersionsSubmittedAsFinal   ThesisProposalVersion[]            @relation("ThesisProposalVersionSubmittedBy")
  ta04BatchesGenerated               Ta04Batch[]                        @relation("Ta04BatchGeneratedBy")

  internshipSupLetterSigned InternshipSupervisorLetter[] @relation("InternshipSupLetterSigner")

  @@map("users")
}

model UserRole {
  id   String @id @default(uuid())
  name String @unique

  thesisSupervisors                  ThesisSupervisors[]
  userHasRoles                       UserHasRole[]
  internshipAppLetterSignedAsRole    InternshipProposal[]         @relation("InternshipAppLetterRole")
  internshipAssignLetterSignedAsRole InternshipProposal[]         @relation("InternshipAssignLetterRole")
  internshipSupLetterSignedAsRole    InternshipSupervisorLetter[] @relation("InternshipSupLetterRole")

  @@map("user_roles")
}

model UserHasRole {
  userId String     @map("user_id")
  roleId String     @map("role_id")
  status RoleStatus
  role   UserRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId], map: "user_has_roles_role_id_fkey")
  @@map("user_has_roles")
}

model Student {
  id                              String                          @id @map("user_id")
  status                          StudentStatus                   @default(active) @map("student_status")
  enrollmentYear                  Int?                            @map("enrollment_year")
  sksCompleted                    Int                             @map("skscompleted")
  mandatoryCoursesCompleted       Boolean                         @default(false) @map("mandatory_courses_completed")
  mkwuCompleted                   Boolean                         @default(false) @map("mkwu_completed")
  internshipCompleted             Boolean                         @default(false) @map("internship_completed")
  kknCompleted                    Boolean                         @default(false) @map("kkn_completed")
  researchMethodCompleted         Boolean                         @default(false) @map("research_method_completed")
  currentSemester                 Int?                            @map("current_semester")
  eligibleMetopen                 Boolean?                        @map("eligible_metopen")
  metopenEligibilitySource        ExternalAcademicSnapshotSource? @map("metopen_eligibility_source")
  metopenEligibilityUpdatedAt     DateTime?                       @map("metopen_eligibility_updated_at")
  takingThesisCourse              Boolean?                        @map("taking_thesis_course")
  thesisCourseEnrollmentSource    ExternalAcademicSnapshotSource? @map("thesis_course_enrollment_source")
  thesisCourseEnrollmentUpdatedAt DateTime?                       @map("thesis_course_enrollment_updated_at")
  createdAt                       DateTime                        @default(now()) @map("created_at")
  updatedAt                       DateTime                        @updatedAt @map("updated_at")
  internships                     Internship[]
  internshipProposalsCoordinated  InternshipProposal[]
  internshipSeminarModerator      InternshipSeminar[]             @relation("InternshipSeminarModerator")
  internshipSeminarAudiences      InternshipSeminarAudience[]     @relation("InternshipSeminarAudience")
  studentCplScores                StudentCplScore[]
  user                            User                            @relation(fields: [id], references: [id], onDelete: Cascade)
  thesis                          Thesis[]
  thesisSeminarAudiences          ThesisSeminarAudience[]
  advisorRequests                 ThesisAdvisorRequest[]
  advisorRequestDraft             ThesisAdvisorRequestDraft?
  thesisStudentInformalLogs       ThesisStudentInformalLog[]
  metopenAttendanceRecords        MetopenAttendanceRecord[]       @relation("MetopenAttendanceRecordStudent")
  academicYearSnapshots           StudentAcademicYearSnapshot[]

  @@index([sksCompleted], map: "idx_students_skscompleted")
  @@map("students")
}

model StudentCplScore {
  studentId   String         @map("student_id") @db.VarChar(199)
  cplId       String         @map("cpl_id") @db.VarChar(255)
  inputBy     String?        @map("input_by") @db.VarChar(255)
  verifiedBy  String?        @map("verified_by") @db.VarChar(255)
  inputAt     DateTime?      @map("input_at")
  score       Int
  source      CplScoreSource @default(SIA)
  status      CplScoreStatus @default(calculated)
  verifiedAt  DateTime?      @map("verified_at")
  finalizedAt DateTime?      @map("finalized_at")

  cpl       Cpl     @relation(fields: [cplId], references: [id])
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  inputUser User?   @relation("CplScoreInputBy", fields: [inputBy], references: [id])
  verifier  User?   @relation("CplScoreVerifiedBy", fields: [verifiedBy], references: [id])

  @@id([studentId, cplId])
  @@index([cplId], map: "student_cpl_scores_cpl_id_fkey")
  @@index([inputBy], map: "student_cpl_scores_input_by_fkey")
  @@index([verifiedBy], map: "student_cpl_scores_verified_by_fkey")
  @@map("student_cpl_scores")
}

model Lecturer {
  id                                 String                            @id @map("user_id")
  scienceGroupId                     String?                           @map("science_group_id")
  data                               Json?
  acceptingRequests                  Boolean                           @default(true) @map("accepting_requests")
  createdAt                          DateTime                          @default(now()) @map("created_at")
  updatedAt                          DateTime                          @updatedAt @map("updated_at")
  internshipAppLettersSigned         InternshipProposal[]              @relation("InternshipAppLetterSigner")
  internshipAssignLettersSigned      InternshipProposal[]              @relation("InternshipAssignLetterSigner")
  internshipsSupervisored            Internship[]                      @relation("InternshipSupervisor")
  internshipGuidanceSessions         InternshipGuidanceSession[]       @relation("InternshipGuidanceLecturer")
  scienceGroup                       ScienceGroup?                     @relation(fields: [scienceGroupId], references: [id])
  user                               User                              @relation(fields: [id], references: [id], onDelete: Cascade)
  thesisChangeRequestApprovals       ThesisChangeRequestApproval[]
  thesisChangeRequestsReviewed       ThesisChangeRequest[]
  thesisGuidances                    ThesisGuidance[]
  thesisSupervisors                  ThesisSupervisors[]
  supervisionQuotas                  LecturerSupervisionQuota[]
  milestoneAssessmentDetails         ThesisMilestoneAssessmentDetail[]
  advisorRequestsReceived            ThesisAdvisorRequest[]            @relation("AdvisorRequestTarget")
  advisorRequestsRedirected          ThesisAdvisorRequest[]            @relation("AdvisorRequestRedirect")
  advisorRequestsForwarded           ThesisAdvisorRequest[]            @relation("AdvisorRequestForwarder")
  availabilities                     LecturerAvailability[]
  seminarExaminers                   ThesisSeminarExaminer[]           @relation("SeminarExaminerLecturer")
  defenceExaminers                   ThesisDefenceExaminer[]           @relation("DefenceExaminerLecturer")
  offeredTopics                      ThesisTopic[]                     @relation("TopicOfferedByLecturer")
  changeRequestsAsNewSupervisor      ThesisChangeRequest[]             @relation("ChangeRequestNewSupervisor")
  changeRequestsAsReplacedSupervisor ThesisChangeRequest[]             @relation("ChangeRequestReplacedSupervisor")
  researchMethodScoresAsSupervisor   ResearchMethodScore[]             @relation("ResearchMethodScoreSupervisor")
  researchMethodScoresAsLecturer     ResearchMethodScore[]             @relation("ResearchMethodScoreLecturer")
  researchMethodScoresAsCoSigner     ResearchMethodScore[]             @relation("ResearchMethodScoreCoSigner")
  advisorRequestDrafts               ThesisAdvisorRequestDraft[]

  internshipSupervisorLetters InternshipSupervisorLetter[]

  @@index([scienceGroupId], map: "lecturers_science_group_id_fkey")
  @@map("lecturers")
}

model LecturerAvailability {
  id         String    @id @default(uuid()) @db.VarChar(255)
  lecturerId String    @map("lecturer_id") @db.VarChar(255)
  day        DayOfWeek
  startTime  DateTime  @map("start_time") @db.Time(0)
  endTime    DateTime  @map("end_time") @db.Time(0)
  validFrom  DateTime  @map("valid_from") @db.Date
  validUntil DateTime  @map("valid_until") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  lecturer Lecturer @relation(fields: [lecturerId], references: [id])

  @@index([lecturerId])
  @@map("lecturer_availabilities")
}

model ScienceGroup {
  id        String        @id @default(uuid())
  name      String
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  lecturers Lecturer[]
  topics    ThesisTopic[]

  @@map("science_groups")
}

model AcademicYear {
  id                                 String                               @id @default(uuid())
  semester                           Semester                             @default(ganjil)
  year                               String                               @db.VarChar(20)
  startDate                          DateTime                             @map("start_date")
  endDate                            DateTime                             @map("end_date")
  isActive                           Boolean                              @default(false) @map("is_active")
  /// Database guard untuk memastikan hanya satu periode memiliki isActive=true.
  /// Nilai "ACTIVE" untuk periode aktif, null untuk seluruh periode lain.
  activeKey                          String?                              @unique @map("active_key") @db.VarChar(16)
  createdAt                          DateTime                             @default(now()) @map("created_at")
  updatedAt                          DateTime                             @updatedAt @map("updated_at")
  internshipProposals                InternshipProposal[]
  thesis                             Thesis[]
  internshipCpmks                    InternshipCpmk[]
  internshipGuidanceQuestions        InternshipGuidanceQuestion[]
  internshipGuidanceLecturerCriteria InternshipGuidanceLecturerCriteria[]
  cpmks                              Cpmk[]
  thesisCpmks                        ThesisCpmk[]
  thesisSeminarRequirements          ThesisSeminarRequirement[]
  thesisDefenceRequirements          ThesisDefenceRequirement[]
  supervisionQuotaDefault            SupervisionQuotaDefault?
  lecturerQuotas                     LecturerSupervisionQuota[]
  advisorRequests                    ThesisAdvisorRequest[]
  advisorRequestsReleased            ThesisAdvisorRequest[]               @relation("AdvisorRequestReleasedAcademicYear")
  yudisiums                          Yudisium[]
  metopenAttendanceImports           MetopenAttendanceImport[]
  metopenCpmks                       MetopenCpmk[]
  metopenScoreComposition            MetopenScoreComposition?
  ta04Batches                        Ta04Batch[]
  ta04AssignmentTheses               Thesis[]                             @relation("ThesisTa04AssignmentAcademicYear")
  activeTheses                       Thesis[]                             @relation("ThesisActiveAcademicYear")
  studentSnapshots                   StudentAcademicYearSnapshot[]

  @@unique([year, semester])
  @@index([startDate, endDate])
  @@map("academic_years")
}

/// Snapshot observasi akademik per mahasiswa dan tahun ajaran aktif saat observasi.
/// `eligibleMetopen` first-write-wins per periode. `takingThesisCourse` ditimpa
/// setiap observasi SIA/devtools (KC-20260814-02). SIA tidak mengirim
/// academicYearId; baris menempel ke ember kalender yang sedang aktif.
model StudentAcademicYearSnapshot {
  id                   String                         @id @default(uuid()) @db.VarChar(191)
  studentId            String                         @map("student_id") @db.VarChar(191)
  academicYearId       String                         @map("academic_year_id") @db.VarChar(191)
  eligibleMetopen      Boolean?                       @map("eligible_metopen")
  researchMethodCompleted Boolean?                    @map("research_method_completed")
  takingThesisCourse   Boolean?                       @map("taking_thesis_course")
  eligibilitySource    ExternalAcademicSnapshotSource? @map("eligibility_source")
  eligibilityCapturedAt DateTime?                     @map("eligibility_captured_at")
  thesisCourseSource   ExternalAcademicSnapshotSource? @map("thesis_course_source")
  thesisCourseCapturedAt DateTime?                    @map("thesis_course_captured_at")
  capturedAt           DateTime                       @map("captured_at")
  createdAt            DateTime                       @default(now()) @map("created_at")
  updatedAt            DateTime                       @updatedAt @map("updated_at")

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  @@unique([studentId, academicYearId], map: "student_ay_snapshots_student_period_key")
  @@index([academicYearId, takingThesisCourse], map: "student_ay_snapshots_period_course_idx")
  @@index([capturedAt], map: "student_ay_snapshots_captured_at_idx")
  @@map("student_academic_year_snapshots")
}

model Room {
  id                 String              @id @default(uuid())
  name               String
  location           String?             @db.VarChar(255)
  capacity           Int?
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  internshipSeminars InternshipSeminar[]
  yudisiums          Yudisium[]
  thesisSeminars     ThesisSeminar[]
  thesisDefences     ThesisDefence[]

  @@map("rooms")
}

model Curriculum {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(255)
  startYear Int      @map("start_year")
  endYear   Int?     @map("end_year")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cpls Cpl[]

  @@map("curriculums")
}

model Cpl {
  id                         String                      @id @default(uuid())
  curriculumId               String?                     @map("curriculum_id") @db.VarChar(255)
  code                       String?                     @db.VarChar(255)
  description                String                      @db.VarChar(255)
  minimalScore               Int                         @map("minimal_score")
  isActive                   Boolean                     @default(true) @map("is_active")
  displayOrder               Int                         @default(0) @map("display_order")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  cpmks                      Cpmk[]
  studentCplScores           StudentCplScore[]
  yudisiumCplRecommendations YudisiumCplRecommendation[]
  curriculum                 Curriculum?                 @relation(fields: [curriculumId], references: [id])

  @@unique([curriculumId, code])
  @@map("cpls")
}

model Cpmk {
  id             String   @id @default(uuid()) @db.VarChar(255)
  academicYearId String?  @map("academic_year_id") @db.VarChar(255)
  cplId          String?  @map("cpl_id") @db.VarChar(255)
  code           String   @db.VarChar(255)
  description    String   @db.VarChar(255)
  type           CpmkType
  displayOrder   Int      @default(0) @map("display_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  academicYear        AcademicYear?        @relation(fields: [academicYearId], references: [id])
  cpl                 Cpl?                 @relation(fields: [cplId], references: [id])
  assessmentCriterias AssessmentCriteria[]

  @@index([academicYearId], map: "cpmks_academic_year_id_fkey")
  @@index([cplId])
  @@map("cpmks")
}

model ThesisCpmk {
  id             String   @id @default(uuid()) @db.VarChar(255)
  academicYearId String   @map("academic_year_id") @db.VarChar(255)
  code           String   @db.VarChar(255)
  description    String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  academicYear                               AcademicYear                                @relation(fields: [academicYearId], references: [id])
  thesisSeminarAssessmentCriterias           ThesisSeminarAssessmentCriteria[]
  thesisDefenceExaminerAssessmentCriterias   ThesisDefenceExaminerAssessmentCriteria[]
  thesisDefenceSupervisorAssessmentCriterias ThesisDefenceSupervisorAssessmentCriteria[]

  @@unique([academicYearId, code])
  @@index([academicYearId], map: "thesis_cpmks_academic_year_id_fkey")
  @@map("thesis_cpmks")
}

model ThesisSeminarAssessmentCriteria {
  id           String   @id @default(uuid()) @db.VarChar(255)
  thesisCpmkId String   @map("thesis_cpmk_id") @db.VarChar(255)
  name         String   @db.VarChar(255)
  maxScore     Int      @map("max_score")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  thesisCpmk                ThesisCpmk                              @relation(fields: [thesisCpmkId], references: [id])
  assessmentRubrics         ThesisSeminarAssessmentRubric[]
  examinerAssessmentDetails ThesisSeminarExaminerAssessmentDetail[]

  @@index([thesisCpmkId], map: "thesis_seminar_assessment_criterias_thesis_cpmk_id_fkey")
  @@map("thesis_seminar_assessment_criterias")
}

model ThesisSeminarAssessmentRubric {
  id                   String   @id @default(uuid()) @db.VarChar(255)
  assessmentCriteriaId String   @map("thesis_seminar_assessment_criteria_id") @db.VarChar(255)
  minScore             Int      @map("min_score")
  maxScore             Int      @map("max_score")
  description          String   @db.Text
  displayOrder         Int      @default(0) @map("display_order")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  assessmentCriteria ThesisSeminarAssessmentCriteria @relation(fields: [assessmentCriteriaId], references: [id])

  @@index([assessmentCriteriaId], map: "thesis_seminar_assessment_rubrics_assessment_criteria_id_fkey")
  @@map("thesis_seminar_assessment_rubrics")
}

model ThesisDefenceExaminerAssessmentCriteria {
  id           String   @id @default(uuid()) @db.VarChar(255)
  thesisCpmkId String   @map("thesis_cpmk_id") @db.VarChar(255)
  name         String   @db.VarChar(255)
  maxScore     Int      @map("max_score")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  thesisCpmk                ThesisCpmk                              @relation(fields: [thesisCpmkId], references: [id])
  assessmentRubrics         ThesisDefenceExaminerAssessmentRubric[]
  examinerAssessmentDetails ThesisDefenceExaminerAssessmentDetail[]

  @@index([thesisCpmkId], map: "thesis_defence_examiner_assessment_criterias_thesis_cpmk_id_fkey")
  @@map("thesis_defence_examiner_assessment_criterias")
}

model ThesisDefenceExaminerAssessmentRubric {
  id                   String   @id @default(uuid()) @db.VarChar(255)
  assessmentCriteriaId String   @map("thesis_defence_examiner_assessment_criteria_id") @db.VarChar(255)
  minScore             Int      @map("min_score")
  maxScore             Int      @map("max_score")
  description          String   @db.Text
  displayOrder         Int      @default(0) @map("display_order")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  assessmentCriteria ThesisDefenceExaminerAssessmentCriteria @relation(fields: [assessmentCriteriaId], references: [id])

  @@index([assessmentCriteriaId], map: "idx_tdea_rubrics_criteria")
  @@map("thesis_defence_examiner_assessment_rubrics")
}

model ThesisDefenceSupervisorAssessmentCriteria {
  id           String   @id @default(uuid()) @db.VarChar(255)
  thesisCpmkId String   @map("thesis_cpmk_id") @db.VarChar(255)
  name         String   @db.VarChar(255)
  maxScore     Int      @map("max_score")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  thesisCpmk                  ThesisCpmk                                @relation(fields: [thesisCpmkId], references: [id])
  assessmentRubrics           ThesisDefenceSupervisorAssessmentRubric[]
  supervisorAssessmentDetails ThesisDefenceSupervisorAssessmentDetail[]

  @@index([thesisCpmkId], map: "idx_tdsa_criterias_cpmk")
  @@map("thesis_defence_supervisor_assessment_criterias")
}

model ThesisDefenceSupervisorAssessmentRubric {
  id                   String   @id @default(uuid()) @db.VarChar(255)
  assessmentCriteriaId String   @map("thesis_defence_supervisor_assessment_criteria_id") @db.VarChar(255)
  minScore             Int      @map("min_score")
  maxScore             Int      @map("max_score")
  description          String   @db.Text
  displayOrder         Int      @default(0) @map("display_order")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  assessmentCriteria ThesisDefenceSupervisorAssessmentCriteria @relation(fields: [assessmentCriteriaId], references: [id])

  @@index([assessmentCriteriaId], map: "idx_tdsa_rubrics_criteria")
  @@map("thesis_defence_supervisor_assessment_rubrics")
}

model AssessmentCriteria {
  id           String              @id @default(uuid()) @db.VarChar(255)
  cpmkId       String              @map("cpmk_id") @db.VarChar(255)
  name         String?             @db.VarChar(255)
  appliesTo    AssessmentAppliesTo @map("applies_to")
  role         AssessmentRole      @default(default)
  maxScore     Int?                @map("max_score")
  isActive     Boolean             @default(true) @map("is_active")
  displayOrder Int                 @default(0) @map("display_order")
  isDeleted    Boolean             @default(false) @map("is_deleted")
  deletedAt    DateTime?           @map("deleted_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  cpmk              Cpmk               @relation(fields: [cpmkId], references: [id])
  assessmentRubrics AssessmentRubric[]

  milestoneTemplateCriterias MilestoneTemplateCriteria[]

  @@index([cpmkId], map: "assessment_criterias_cpmk_id_fkey")
  @@map("assessment_criterias")
}

model AssessmentRubric {
  id                   String    @id @default(uuid()) @db.VarChar(255)
  assessmentCriteriaId String    @map("assessment_criteria_id") @db.VarChar(255)
  minScore             Int       @default(0) @map("min_score")
  maxScore             Int       @default(0) @map("max_score")
  description          String    @db.Text
  displayOrder         Int       @default(0) @map("display_order")
  isDeleted            Boolean   @default(false) @map("is_deleted")
  deletedAt            DateTime? @map("deleted_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  assessmentCriteria         AssessmentCriteria                @relation(fields: [assessmentCriteriaId], references: [id])
  milestoneAssessmentDetails ThesisMilestoneAssessmentDetail[]

  @@index([assessmentCriteriaId], map: "assessment_rubrics_assessment_criteria_id_fkey")
  @@map("assessment_rubrics")
}

/// CPMK khusus modul Metode Penelitian (Metopen). Dipisahkan dari Cpmk
/// generik (yang menampung type=research_method + thesis) agar tabel
/// metopen tidak tercampur dengan CPMK modul TA penuh. Canon §5.7.
/// Migrasi data dari cpmks (type=research_method) → metopen_cpmks
/// dilakukan oleh scripts/migrate_metopen_data.mjs.
model MetopenCpmk {
  id             String   @id @default(uuid()) @db.VarChar(191)
  academicYearId String   @map("academic_year_id") @db.VarChar(191)
  code           String   @db.VarChar(255)
  description    String   @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  academicYear               AcademicYear                @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  metopenAssessmentCriterias MetopenAssessmentCriteria[]

  @@index([academicYearId], map: "metopen_cpmks_academic_year_id_fkey")
  @@unique([academicYearId, code], map: "metopen_cpmks_period_code_key")
  @@map("metopen_cpmks")
}

/// Komposisi batas poin TA-03A:TA-03B per tahun akademik (default 75:25).
/// Formula tetap additive: finalScore = supervisorScore + lecturerScore.
/// Sekdep dapat mengubah selama belum ada ResearchMethodScore finalized
/// pada thesis di tahun akademik yang sama. Cap ≠ bobot persen.
model MetopenScoreComposition {
  id             String   @id @default(uuid()) @db.VarChar(191)
  academicYearId String   @unique @map("academic_year_id") @db.VarChar(191)
  /// Batas poin TA-03A (role supervisor). Default 75.
  ta03aCap       Int      @default(75) @map("ta03a_cap")
  /// Batas poin TA-03B (role default / Koordinator Metopen). Default 25.
  ta03bCap       Int      @default(25) @map("ta03b_cap")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@map("metopen_score_compositions")
}

/// Kriteria penilaian Metopen (TA-03A supervisor / TA-03B koordinator).
/// Batas peran (cap) per tahun akademik ada di MetopenScoreComposition
/// (default 75:25). Dipisahkan dari AssessmentCriteria generik yang
/// menampung appliesTo + isActive + isDeleted. Tabel ini hard-delete
/// (tidak ada soft-delete) sesuai desain metopen admin rubric management.
/// Canon §5.7.1 (P1+P2 co-sign) + §5.7 (TA-03B koordinator).
model MetopenAssessmentCriteria {
  id            String         @id @default(uuid()) @db.VarChar(191)
  metopenCpmkId String         @map("metopen_cpmk_id") @db.VarChar(191)
  name          String?        @db.VarChar(255)
  role          AssessmentRole @default(default)
  maxScore      Int?           @map("max_score")
  displayOrder  Int            @default(0) @map("display_order")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  metopenCpmk                MetopenCpmk                 @relation(fields: [metopenCpmkId], references: [id])
  metopenAssessmentRubrics   MetopenAssessmentRubric[]
  researchMethodScoreDetails ResearchMethodScoreDetail[]

  @@index([metopenCpmkId], map: "metopen_assessment_criterias_metopen_cpmk_id_fkey")
  @@map("metopen_assessment_criterias")
}

/// Level rubrik penilaian Metopen. Dipisahkan dari AssessmentRubric generik
/// (tanpa isDeleted/deletedAt — hard delete). Dipakai oleh RubricGradingForm
/// untuk selection descriptor saat supervisor/koordinator input nilai.
model MetopenAssessmentRubric {
  id                          String   @id @default(uuid()) @db.VarChar(191)
  metopenAssessmentCriteriaId String   @map("metopen_assessment_criteria_id") @db.VarChar(191)
  minScore                    Int      @default(0) @map("min_score")
  maxScore                    Int      @default(0) @map("max_score")
  description                 String   @db.Text
  displayOrder                Int      @default(0) @map("display_order")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  metopenAssessmentCriteria  MetopenAssessmentCriteria   @relation(fields: [metopenAssessmentCriteriaId], references: [id])
  researchMethodScoreDetails ResearchMethodScoreDetail[]

  @@index([metopenAssessmentCriteriaId], map: "metopen_assessment_rubrics_metopen_assessment_criteria_id_fkey")
  @@map("metopen_assessment_rubrics")
}

model ExitSurveyForm {
  id          String   @id @default(uuid()) @db.VarChar(255)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sessions             ExitSurveySession[]
  questions            ExitSurveyQuestion[]
  yudisiums            Yudisium[]
  yudisiumParticipants YudisiumParticipant[]

  @@map("exit_survey_forms")
}

model ExitSurveySession {
  id               String   @id @default(uuid()) @db.VarChar(255)
  exitSurveyFormId String   @map("exit_survey_form_id") @db.VarChar(255)
  name             String   @db.VarChar(255)
  description      String?  @db.Text
  order            Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  form      ExitSurveyForm       @relation(fields: [exitSurveyFormId], references: [id], onDelete: Cascade)
  questions ExitSurveyQuestion[]

  @@unique([id, exitSurveyFormId])
  @@index([exitSurveyFormId], map: "exit_survey_sessions_exit_survey_form_id_fkey")
  @@map("exit_survey_sessions")
}

model ExitSurveyQuestion {
  id                  String                 @id @default(uuid()) @db.VarChar(255)
  exitSurveySessionId String                 @map("exit_survey_session_id") @db.VarChar(255)
  exitSurveyFormId    String                 @map("exit_survey_form_id") @db.VarChar(255)
  question            String                 @db.Text
  description         String?                @db.Text
  questionType        ExitSurveyQuestionType @map("question_type")
  isRequired          Boolean                @default(false) @map("is_required")
  orderNumber         Int                    @map("order_number")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  session                          ExitSurveySession                     @relation(fields: [exitSurveySessionId, exitSurveyFormId], references: [id, exitSurveyFormId], onDelete: Cascade)
  form                             ExitSurveyForm                        @relation(fields: [exitSurveyFormId], references: [id])
  options                          ExitSurveyOption[]
  studentExitSurveyAnswers         StudentExitSurveyAnswer[]
  yudisiumParticipantSurveyAnswers YudisiumParticipantExitSurveyAnswer[]

  @@unique([id, exitSurveyFormId])
  @@index([exitSurveySessionId, exitSurveyFormId], map: "exit_survey_questions_exit_survey_session_id_fkey")
  @@index([exitSurveyFormId], map: "exit_survey_questions_exit_survey_form_id_fkey")
  @@map("exit_survey_questions")
}

model ExitSurveyOption {
  id                   String   @id @default(uuid()) @db.VarChar(255)
  exitSurveyQuestionId String   @map("exit_survey_question_id") @db.VarChar(255)
  optionText           String   @map("option_text") @db.VarChar(255)
  orderNumber          Int      @map("order_number")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  question                         ExitSurveyQuestion                    @relation(fields: [exitSurveyQuestionId], references: [id], onDelete: Cascade)
  studentExitSurveyAnswers         StudentExitSurveyAnswer[]
  yudisiumParticipantSurveyAnswers YudisiumParticipantExitSurveyAnswer[]

  @@unique([id, exitSurveyQuestionId])
  @@index([exitSurveyQuestionId], map: "exit_survey_options_exit_survey_question_id_fkey")
  @@map("exit_survey_options")
}

/// Thesis = shared container antara SIMPTA (proposal phase, isProposal=true)
/// dan Modul Tugas Akhir penuh (isProposal=false, post-promosi aktif setelah
/// TA-03 final + snapshot KRS TA true; bukan hanya karena TA-04 terbit).
/// Lihat HANDOFF_SCHEMA_SIMPTA_REVISI.md §5 P0-06 untuk field ownership matrix.
model Thesis {
  // === IDENTITAS & PHASE FLAG ===
  id             String    @id @default(uuid())
  /// Flag transisi ownership: true = SIMPTA scope; false = Modul TA scope setelah promosi aktif.
  isProposal     Boolean   @default(true) @map("is_proposal")
  studentId      String    @map("student_id")
  thesisTopicId  String?   @map("thesis_topic_id")
  thesisStatusId String?   @map("thesis_status_id")
  /// NOTE: canon §5.7.4 + §5.13 expect non-null setelah TA-04. Pertimbangkan
  /// migrate ke NOT NULL di iterasi berikutnya.
  academicYearId String?   @map("academic_year_id")
  title          String?   @db.Text
  startDate      DateTime? @map("start_date")

  // === SIMPTA SCOPE: Proposal Versioning & Submission (canon §5.6) ===
  /// Source of truth proposal final aktif. Pointer ke ThesisProposalVersion
  /// yang ditetapkan via aksi "Submit Final" eksplisit oleh mahasiswa.
  finalProposalVersionId String?         @map("final_proposal_version_id") @db.VarChar(191)
  proposalStatus         ProposalStatus? @map("proposal_status")

  // === SIMPTA SCOPE: TA-04 KaDep Decision Audit (canon §5.8, §5.13) ===
  titleApprovalDocumentId       String?   @map("title_approval_document_id")
  proposalReviewNotes           String?   @map("proposal_review_notes") @db.Text
  proposalReviewedAt            DateTime? @map("proposal_reviewed_at")
  proposalReviewedByUserId      String?   @map("proposal_reviewed_by_user_id") @db.VarChar(191)
  /// TA-04 awal = SK penugasan resmi setelah TA-01/TA-02 booking disetujui.
  /// Metadata ini membekukan judul + nama pembimbing yang tampil pada batch
  /// pertama; promosi beban aktif tetap menunggu TA-03 final + KRS TA.
  ta04AssignmentIssuedAt        DateTime? @map("ta04_assignment_issued_at")
  ta04AssignmentIssuedByUserId  String?   @map("ta04_assignment_issued_by_user_id") @db.VarChar(191)
  ta04AssignmentTitle           String?   @map("ta04_assignment_title") @db.Text
  ta04AssignmentSupervisorNames String?   @map("ta04_assignment_supervisor_names") @db.Text
  ta04AssignmentAcademicYearId  String?   @map("ta04_assignment_academic_year_id")
  /// Tahun akademik beban aktif setelah promosi otomatis dari booking.
  activeAcademicYearId          String?   @map("active_academic_year_id")
  activePromotedAt              DateTime? @map("active_promoted_at")

  // === MODUL TA SCOPE (post-promosi aktif, isProposal=false — BUKAN SIMPTA scope) ===
  /// out-of-SIMPTA-scope: Modul TA penuh. Rating monitoring (ONGOING/SLOW/AT_RISK/FAILED).
  rating                ThesisRating @default(ONGOING)
  /// out-of-SIMPTA-scope: Modul TA penuh — deadline absolut thesis.
  deadlineDate          DateTime?    @map("deadline_date")
  /// out-of-SIMPTA-scope: Modul TA penuh — final thesis document setelah Sidang.
  finalThesisDocumentId String?      @map("final_thesis_document_id")
  /// out-of-SIMPTA-scope: Modul TA penuh — defence registration timestamp.
  defenceRequestedAt    DateTime?    @map("defence_requested_at")

  // === LEGACY (deprecated per PRD §5.2) ===
  /// @deprecated Use `finalProposalVersionId` instead. Sumber: canon §5.6 + PRD §5.2.
  /// Akan di-drop pada migration berikutnya setelah audit memastikan tidak ada read sisa.
  /// Sumber: HANDOFF §5 P0-06.
  proposalDocumentId String? @map("proposal_document_id")
  /// @deprecated Semantic legacy unclear. Audit sebelum drop. Sumber: PRD §5.2.
  documentId         String? @map("document_id")

  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  // Relations
  academicYear               AcademicYear?               @relation(fields: [academicYearId], references: [id])
  document                   Document?                   @relation(fields: [documentId], references: [id])
  finalThesisDocument        Document?                   @relation("FinalThesisDocument", fields: [finalThesisDocumentId], references: [id])
  proposalDocument           Document?                   @relation("ProposalDocument", fields: [proposalDocumentId], references: [id])
  finalProposalVersion       ThesisProposalVersion?      @relation("FinalProposalVersion", fields: [finalProposalVersionId], references: [id])
  titleApprovalDocument      Document?                   @relation("TitleApprovalDocument", fields: [titleApprovalDocumentId], references: [id])
  proposalReviewedBy         User?                       @relation("ThesisProposalReviewedBy", fields: [proposalReviewedByUserId], references: [id])
  ta04AssignmentIssuedBy     User?                       @relation("ThesisTa04AssignmentIssuedBy", fields: [ta04AssignmentIssuedByUserId], references: [id], onDelete: SetNull)
  ta04AssignmentAcademicYear AcademicYear?               @relation("ThesisTa04AssignmentAcademicYear", fields: [ta04AssignmentAcademicYearId], references: [id])
  activeAcademicYear         AcademicYear?               @relation("ThesisActiveAcademicYear", fields: [activeAcademicYearId], references: [id])
  student                    Student                     @relation(fields: [studentId], references: [id])
  thesisStatus               ThesisStatus?               @relation(fields: [thesisStatusId], references: [id])
  thesisTopic                ThesisTopic?                @relation(fields: [thesisTopicId], references: [id])
  thesisGuidanceEvaluations  ThesisGuidanceEvaluation[]
  thesisChangeRequests       ThesisChangeRequest[]
  thesisDefences             ThesisDefence[]
  thesisGuidances            ThesisGuidance[]
  thesisMilestones           ThesisMilestone[]
  thesisSupervisors          ThesisSupervisors[]
  thesisSeminars             ThesisSeminar[]
  yudisiumParticipants       YudisiumParticipant[]
  studentExitSurveyResponses StudentExitSurveyResponse[]
  researchMethodScores       ResearchMethodScore[]
  advisorRequests            ThesisAdvisorRequest[]
  proposalVersions           ThesisProposalVersion[]
  studentInformalLogs        ThesisStudentInformalLog[]
  ta04BatchMembers           Ta04BatchMember[]

  @@index([academicYearId], map: "thesis_academic_year_id_fkey")
  @@index([documentId], map: "thesis_document_id_fkey")
  @@index([finalThesisDocumentId], map: "thesis_final_thesis_document_id_fkey")
  @@index([proposalDocumentId], map: "thesis_proposal_document_id_fkey")
  @@index([finalProposalVersionId], map: "thesis_final_proposal_version_id_fkey")
  @@index([titleApprovalDocumentId])
  @@index([proposalReviewedByUserId], map: "thesis_proposal_reviewed_by_user_id_fkey")
  @@index([ta04AssignmentIssuedByUserId], map: "thesis_ta04_assignment_issued_by_user_id_fkey")
  @@index([ta04AssignmentAcademicYearId], map: "thesis_ta04_assignment_academic_year_id_fkey")
  @@index([activeAcademicYearId], map: "thesis_active_academic_year_id_fkey")
  @@index([studentId], map: "thesis_student_id_fkey")
  @@index([thesisStatusId], map: "thesis_thesis_status_id_fkey")
  @@index([thesisTopicId], map: "thesis_thesis_topic_id_fkey")
  @@map("thesis")
}

/// Formulir TA-04 resmi per periode. Source of truth dokumen batch current
/// disimpan di sini, bukan disimpulkan dari pointer per-thesis yang bisa stale.
model Ta04Batch {
  id                String   @id @default(uuid())
  academicYearId    String   @map("academic_year_id")
  documentId        String   @map("document_id")
  version           Int      @default(1)
  /// String status sengaja dipakai untuk menghindari enum DB baru.
  /// Nilai aktif: current, superseded.
  status            String   @default("current") @db.VarChar(32)
  cohortHash        String   @map("cohort_hash") @db.VarChar(64)
  generatedByUserId String?  @map("generated_by_user_id")
  generatedAt       DateTime @default(now()) @map("generated_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  academicYear AcademicYear      @relation(fields: [academicYearId], references: [id])
  document     Document          @relation("Ta04BatchDocument", fields: [documentId], references: [id])
  generatedBy  User?             @relation("Ta04BatchGeneratedBy", fields: [generatedByUserId], references: [id], onDelete: SetNull)
  members      Ta04BatchMember[]

  @@unique([academicYearId, version])
  @@index([academicYearId, status])
  @@index([documentId])
  @@index([generatedByUserId])
  @@index([cohortHash])
  @@map("ta04_batches")
}

/// Snapshot anggota yang masuk ke Formulir TA-04 pada saat batch dibuat.
/// Snapshot menjaga isi PDF tetap audit-able walaupun nama/judul/pembimbing
/// berubah setelahnya.
model Ta04BatchMember {
  id              String   @id @default(uuid())
  batchId         String   @map("batch_id")
  thesisId        String   @map("thesis_id")
  studentName     String   @map("student_name")
  studentNim      String   @map("student_nim") @db.VarChar(50)
  title           String   @db.Text
  supervisorNames String   @map("supervisor_names") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  batch  Ta04Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  thesis Thesis    @relation(fields: [thesisId], references: [id])

  @@unique([batchId, thesisId])
  @@index([thesisId])
  @@map("ta04_batch_members")
}

/// Catatan bimbingan informal fase Metopen: mahasiswa membuat/mengubah catatan;
/// P1/P2 aktif dapat membaca read-only setelah TA-04. Tidak memiliki workflow
/// approval dan tidak menggantikan thesis_guidances (alur sesi formal pasca-promosi).
model ThesisStudentInformalLog {
  id         String   @id @default(uuid())
  thesisId   String   @map("thesis_id")
  studentId  String   @map("student_id")
  content    String   @db.Text
  documentId String?  @map("document_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  thesis   Thesis    @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  document Document? @relation("ThesisInformalLogDocument", fields: [documentId], references: [id], onDelete: SetNull)

  @@index([thesisId], map: "thesis_student_informal_logs_thesis_id_fkey")
  @@index([studentId], map: "thesis_student_informal_logs_student_id_fkey")
  @@index([documentId], map: "thesis_student_informal_logs_document_id_fkey")
  @@map("thesis_student_informal_logs")
}

/// @deprecated TA-05 frozen — do not extend.
/// Flow digital pergantian judul/pembimbing dibekukan untuk seluruh siklus
/// rilis aktif (KONTEKS_KANONIS_SIMPTA.md §5.11). Schema dipertahankan untuk
/// kompatibilitas dan regresi safety; tidak boleh dijadikan jalur operasional
/// baru tanpa update keputusan kanonis lebih dulu.
model ThesisChangeRequest {
  id                           String                        @id @default(uuid())
  thesisId                     String?                       @map("thesis_id")
  requestType                  ThesisChangeRequestType       @map("request_type")
  reason                       String                        @db.Text
  status                       ThesisChangeRequestStatus     @default(pending)
  reviewedBy                   String?                       @map("reviewed_by")
  reviewNotes                  String?                       @map("review_notes") @db.Text
  reviewedAt                   DateTime?                     @map("reviewed_at")
  newTopicId                   String?                       @map("new_topic_id")
  newTitle                     String?                       @map("new_title") @db.VarChar(500)
  newSupervisorId              String?                       @map("new_supervisor_id")
  supportingDocumentId         String?                       @map("supporting_document_id")
  replacedSupervisorLecturerId String?                       @map("replaced_supervisor_lecturer_id")
  createdAt                    DateTime                      @default(now()) @map("created_at")
  updatedAt                    DateTime                      @updatedAt @map("updated_at")
  approvals                    ThesisChangeRequestApproval[]
  reviewer                     Lecturer?                     @relation(fields: [reviewedBy], references: [id])
  thesis                       Thesis?                       @relation(fields: [thesisId], references: [id])
  newTopic                     ThesisTopic?                  @relation("ChangeRequestNewTopic", fields: [newTopicId], references: [id])
  newSupervisor                Lecturer?                     @relation("ChangeRequestNewSupervisor", fields: [newSupervisorId], references: [id], onDelete: SetNull)
  supportingDocument           Document?                     @relation("ChangeRequestSupportingDocument", fields: [supportingDocumentId], references: [id], onDelete: SetNull)
  replacedSupervisor           Lecturer?                     @relation("ChangeRequestReplacedSupervisor", fields: [replacedSupervisorLecturerId], references: [id], onDelete: SetNull)

  @@index([reviewedBy], map: "thesis_change_requests_reviewed_by_fkey")
  @@index([thesisId], map: "thesis_change_requests_thesis_id_fkey")
  @@index([newTopicId])
  @@index([newSupervisorId])
  @@index([supportingDocumentId])
  @@index([replacedSupervisorLecturerId])
  @@map("thesis_change_requests")
}

model ThesisChangeRequestApproval {
  id           String              @id @default(uuid())
  requestId    String              @map("request_id")
  lecturerId   String              @map("lecturer_id")
  status       ApprovalStatus      @default(pending)
  notes        String?             @db.Text
  /// 1 = pembimbing saat ini (tier lama); 2 = pembimbing baru (setelah semua tier 1 disetujui)
  approvalTier Int                 @default(1) @map("approval_tier")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  lecturer     Lecturer            @relation(fields: [lecturerId], references: [id])
  request      ThesisChangeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, lecturerId])
  @@index([lecturerId], map: "thesis_change_request_approvals_lecturer_id_fkey")
  @@index([requestId, approvalTier])
  @@map("thesis_change_request_approvals")
}

model ThesisSupervisors {
  id                                 String                     @id @default(uuid())
  thesisId                           String                     @map("thesis_id")
  lecturerId                         String                     @map("lecturer_id")
  roleId                             String                     @map("role_id")
  status                             SupervisorStatus           @default(active)
  /// Unique guard for one active assignment per (thesis, role). Null when not active
  /// so terminated/released history rows do not collide (MySQL UNIQUE allows many NULL).
  activeRoleKey                      String?                    @unique @map("active_role_key") @db.VarChar(191)
  seminarReady                       Boolean                    @default(false) @map("seminar_ready")
  defenceReady                       Boolean                    @default(false) @map("defence_ready")
  createdAt                          DateTime                   @default(now()) @map("created_at")
  updatedAt                          DateTime                   @updatedAt @map("updated_at")
  lecturer                           Lecturer                   @relation(fields: [lecturerId], references: [id])
  role                               UserRole                   @relation(fields: [roleId], references: [id])
  thesis                             Thesis                     @relation(fields: [thesisId], references: [id])
  guidanceEvaluations                ThesisGuidanceEvaluation[]
  thesisSeminarAudienceApprovals     ThesisSeminarAudience[]
  thesisSeminarRevisionApprovals     ThesisSeminarRevision[]
  thesisSeminarResultFinalizations   ThesisSeminar[]            @relation("SeminarResultFinalizedBy")
  thesisSeminarRevisionFinalizations ThesisSeminar[]            @relation("SeminarRevisionFinalizedBy")
  thesisDefenceResultFinalizations   ThesisDefence[]            @relation("DefenceResultFinalizedBy")
  thesisDefenceRevisionFinalizations ThesisDefence[]            @relation("DefenceRevisionFinalizedBy")
  thesisDefenceRevisionApprovals     ThesisDefenceRevision[]

  @@unique([id, thesisId])
  @@index([lecturerId], map: "thesis_participants_lecturer_id_fkey")
  @@index([roleId], map: "thesis_participants_role_id_fkey")
  @@index([thesisId], map: "thesis_participants_thesis_id_fkey")
  @@index([thesisId, roleId, status])
  @@map("thesis_supervisors")
}

model ThesisGuidanceEvaluation {
  id                 String                           @id @default(uuid())
  thesisId           String                           @map("thesis_id")
  thesisSupervisorId String                           @map("thesis_supervisor_id")
  evaluationType     GuidanceEvaluationType           @map("evaluation_type")
  recommendation     GuidanceEvaluationRecommendation
  notes              String?                          @db.Text
  status             GuidanceEvaluationStatus         @default(pending)
  kadepApprovedBy    String?                          @map("kadep_approved_by")
  kadepApprovedAt    DateTime?                        @map("kadep_approved_at")
  kadepNotes         String?                          @map("kadep_notes") @db.Text
  createdAt          DateTime                         @default(now()) @map("created_at")
  updatedAt          DateTime                         @updatedAt @map("updated_at")
  thesis             Thesis                           @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  thesisSupervisor   ThesisSupervisors                @relation(fields: [thesisSupervisorId], references: [id], onDelete: Cascade)
  kadepApprover      User?                            @relation("GuidanceEvalKadepApprover", fields: [kadepApprovedBy], references: [id], onDelete: SetNull)

  @@index([thesisId])
  @@index([thesisSupervisorId])
  @@index([status])
  @@map("thesis_guidance_evaluations")
}

model ThesisTopic {
  id             String   @id @default(uuid())
  name           String
  scienceGroupId String?  @map("science_group_id")
  lecturerId     String?  @map("lecturer_id")
