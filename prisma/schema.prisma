// ==================== Supervision Quota ====================

/// Batas bimbingan dosen (10.1). `academic_year_id` kosong = batas umum; terisi = batas
/// periode yang menimpa batas umum untuk satu semester. Batas lunak hanya peringatan;
/// melewati batas keras berarti Pengajuan di Atas Kuota yang disahkan Ketua Departemen.
model SupervisionQuota {
  id              String   @id @default(uuid())
  academicYearId  String?  @unique @map("academic_year_id")
  softLimit       Int      @map("soft_limit")
  hardLimit       Int      @map("hard_limit")
  updatedByUserId String?  @map("updated_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])
  updatedBy    User?         @relation("SupervisionQuotaUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
  @@map("supervision_quotas")
}

// ==================== Audit Log ====================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String   @db.VarChar(50)
  entity    String   @db.VarChar(100)
  entityId  String?  @map("entity_id")
  changes   Json?
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
