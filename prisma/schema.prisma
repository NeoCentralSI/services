  assessmentCriteria ResearchMethodCoordinatorAssessmentCriteria @relation(fields: [assessmentCriteriaId], references: [id], onDelete: Cascade, map: "rm_coordinator_rubrics_criteria_fkey")
  assessmentDetails  ResearchMethodCoordinatorAssessmentDetail[]

  @@index([assessmentCriteriaId], map: "rm_coordinator_rubrics_criteria_id_fkey")
  @@map("research_method_coordinator_assessment_rubrics")
}

